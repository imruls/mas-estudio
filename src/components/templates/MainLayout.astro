---
import { Font } from "astro:assets";
import "../../styles/Style.css";
import { siteData } from "../../data/DataSite";
import Navbar from "../organisms/Navbar.astro";
import Footer from "../organisms/Footer.astro";
import WhatsAppFloatingButton from "../molecules/WhatsAppFloatingButton.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteData.seo.title, description = siteData.seo.description } =
  Astro.props;

// El dominio vive en astro.config.mjs (`site`), no duplicado en DataSite.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(siteData.seo.ogImage, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteData.brand.fullName} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-heading" preload />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloatingButton />
  </body>
</html>
