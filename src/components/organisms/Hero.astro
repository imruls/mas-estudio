---
import { Image } from "astro:assets";
import heroBackground from "../../assets/hero/hero-background.jpg";
import { siteData } from "../../data/DataSite";
import { whatsappLink } from "../../utils/contact";

const heroStats = [
  { target: 9, suffix: "+", label: "Años de trayectoria" },
  { target: 100, suffix: "%", label: "Atención personalizada" },
];
---

<section class="hero" id="inicio">
  <Image
    src={heroBackground}
    alt=""
    class="hero__bg"
    width={1600}
    widths={[640, 1024, 1600]}
    sizes="100vw"
    quality={65}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">{siteData.hero.title}</h1>
      <p class="hero__subtitle">{siteData.hero.subtitle}</p>
      <dl class="hero__stats">
        {
          heroStats.map((stat) => (
            <div class="hero__stat">
              <dt
                class="hero__stat-number"
                data-target={stat.target}
                data-suffix={stat.suffix}
              >
                {stat.target}
                {stat.suffix}
              </dt>
              <dd class="hero__stat-label">{stat.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__actions">
        <a
          class="btn btn-primary"
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
        >
          {siteData.hero.ctaPrimary}
        </a>
        <a class="hero__cta-secondary" href="#servicios">
          {siteData.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* Sin imports a propósito: Astro solo deja el script inline (sin pedido
     extra) mientras no importe nada, y acá son 20 líneas propias. */
  const numbers = document.querySelectorAll<HTMLElement>(".hero__stat-number");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (numbers.length && !prefersReducedMotion) {
    const DURATION = 1200;

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.target ?? "0");
      const suffix = el.dataset.suffix ?? "";
      const start = performance.now();

      const step = (now: number) => {
        const progress = Math.min((now - start) / DURATION, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(target * eased)}${suffix}`;

        if (progress < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          countUp(entry.target as HTMLElement);
        }
      },
      { threshold: 0.4 },
    );

    numbers.forEach((el) => observer.observe(el));
  }
</script>
