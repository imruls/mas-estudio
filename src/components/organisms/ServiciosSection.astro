---
import { siteData } from "../../data/DataSite";
import ServiceCard from "../molecules/ServiceCard.astro";
import CarouselToggle from "../molecules/CarouselToggle.astro";
import WhatsAppIcon from "../atoms/WhatsAppIcon.astro";
import NewTabNotice from "../atoms/NewTabNotice.astro";
import { whatsappLink } from "../../utils/contact";

const total = siteData.practiceAreas.length;
---

<section class="services" id="servicios" aria-labelledby="servicios-titulo">
  <div class="container">
    <div class="services__heading">
      <h2 id="servicios-titulo">{siteData.practiceAreasSection.title}</h2>
    </div>

    <div
      class="services-carousel"
      role="region"
      aria-roledescription="carrusel"
      aria-label={siteData.practiceAreasSection.title}
    >
      {/* Sin links adentro, el viewport necesita su propio tabindex para
          que se pueda desplazar con las flechas del teclado (ver el de
          reseñas). */}
      <div
        class="services-carousel__viewport"
        id="services-viewport"
        tabindex="0"
      >
        <div class="services-carousel__track" id="services-track">
          {
            siteData.practiceAreas.map((area, index) => (
              <ServiceCard
                area={area}
                isLast={index === total - 1}
                slideLabel={`${index + 1} de ${total}`}
              />
            ))
          }
          <div class="services-carousel__clone" aria-hidden="true" inert>
            {siteData.practiceAreas.map((area) => <ServiceCard area={area} />)}
          </div>
        </div>
      </div>

      <div class="services-carousel__controls">
        <div class="services-carousel__dots" id="services-dots">
          {
            siteData.practiceAreas.map((area, index) => (
              <button
                type="button"
                class:list={["services-carousel__dot", { "is-active": index === 0 }]}
                data-index={index}
                aria-label={`Ir a ${area.title}`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
        <CarouselToggle id="services-toggle" target="el carrusel de áreas" />
      </div>
    </div>

    {/* Un solo CTA para toda la sección en vez de uno por card. */}
    <div class="services__cta">
      <a
        class="btn services__cta-link"
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppIcon size={22} />
        {siteData.practiceAreasSection.ctaLabel}
        <NewTabNotice />
      </a>
    </div>
  </div>
</section>

<script>
  /* Ver Hero: sin imports para que Astro lo deje inline. */
  const viewport = document.getElementById("services-viewport");
  const track = document.getElementById("services-track");
  const dots = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".services-carousel__dot"),
  );

  if (viewport && track && dots.length > 0) {
    const isMobile = window.matchMedia("(max-width: 767px)").matches;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const setActiveDot = (index: number) => {
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-current", active ? "true" : "false");
      });
    };

    const getStep = () => {
      const card = track.querySelector(".service-card");
      if (!card) return viewport.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      return card.getBoundingClientRect().width + gap;
    };

    if (isMobile) {
      // En mobile no hay auto-scroll: el usuario decide si desliza
      // las cards. Solo reflejamos su posición en los dots y
      // permitimos saltar a una card tocando su dot.
      let scrollRaf: number | undefined;

      const updateActiveDotFromScroll = () => {
        const step = getStep();
        if (!step) return;
        const index = Math.round(viewport.scrollLeft / step);
        setActiveDot(Math.max(0, Math.min(index, dots.length - 1)));
      };

      viewport.addEventListener(
        "scroll",
        () => {
          if (scrollRaf) return;
          scrollRaf = requestAnimationFrame(() => {
            updateActiveDotFromScroll();
            scrollRaf = undefined;
          });
        },
        { passive: true },
      );

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          viewport.scrollTo({
            left: index * getStep(),
            behavior: reducedMotion ? "auto" : "smooth",
          });
          setActiveDot(index);
        });
      });
    } else {
      const SPEED = 40; // px por segundo
      const toggle = document.getElementById("services-toggle");

      // isPaused lo manejan el foco y el toque, y se reanuda solo (el hover
      // no pausa: para eso está el botón). userPaused es el botón de pausa
      // (WCAG 2.2.2) y queda hasta que lo vuelvan a tocar.
      let isPaused = false;
      let userPaused = false;
      let resumeTimer: number | undefined;
      let lastTime: number | null = null;

      // Período del loop: lo que mide un set de cards más el gap que lo separa
      // de la copia. Con scrollWidth / 2 a secas faltaba medio gap y cada
      // vuelta daba un salto de 20px en desktop.
      const halfWidth = () =>
        (track.scrollWidth + parseFloat(getComputedStyle(track).columnGap || "0")) /
        2;

      const wrap = () => {
        const half = halfWidth();
        if (viewport.scrollLeft >= half) {
          viewport.scrollLeft -= half;
        } else if (viewport.scrollLeft < 0) {
          viewport.scrollLeft += half;
        }
      };

      const updateActiveDot = () => {
        const step = getStep();
        const half = halfWidth();
        const pos = ((viewport.scrollLeft % half) + half) % half;
        const index = Math.round(pos / step) % dots.length;
        setActiveDot(index);
      };

      const tick = (time: number) => {
        if (lastTime === null) lastTime = time;
        const delta = (time - lastTime) / 1000;
        lastTime = time;

        if (!isPaused && !userPaused && !reducedMotion) {
          viewport.scrollLeft += SPEED * delta;
          wrap();
        }
        updateActiveDot();
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      const pause = () => {
        isPaused = true;
        window.clearTimeout(resumeTimer);
      };
      const resume = () => {
        window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          isPaused = false;
        }, 300);
      };

      if (toggle && !reducedMotion) {
        toggle.hidden = false;
        const label = toggle.querySelector(".carousel-toggle__label");

        toggle.addEventListener("click", () => {
          userPaused = !userPaused;
          toggle.dataset.paused = String(userPaused);
          if (label) label.textContent = userPaused ? "Reanudar" : "Pausar";
        });
      }

      viewport.addEventListener("focusin", pause);
      viewport.addEventListener("focusout", resume);
      viewport.addEventListener("pointerdown", pause);
      viewport.addEventListener("pointerup", resume);
      viewport.addEventListener("pointercancel", resume);
      viewport.addEventListener("touchstart", pause, { passive: true });
      viewport.addEventListener("touchend", resume, { passive: true });
      viewport.addEventListener("touchcancel", resume, { passive: true });

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          pause();

          const step = getStep();
          const half = halfWidth();
          const currentSet = Math.floor(viewport.scrollLeft / half) * half;

          viewport.scrollTo({
            left: currentSet + index * step,
            behavior: reducedMotion ? "auto" : "smooth",
          });
          setActiveDot(index);

          window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(resume, 2000);
        });
      });
    }
  }
</script>
