---
import Icon from "../atoms/Icon.astro";

/* Botón para pausar un carrusel con auto-scroll (WCAG 2.2.2). Arranca
   oculto: el script del carrusel lo muestra solo si el auto-scroll corre,
   y es quien cambia `data-paused` y el texto de la etiqueta. */
interface Props {
  id: string;
  /* Completa el nombre accesible: "Pausar" + "el carrusel de reseñas". */
  target: string;
}

const { id, target } = Astro.props;
---

<button type="button" class="carousel-toggle" id={id} data-paused="false" hidden>
  <span class="carousel-toggle__icon carousel-toggle__icon--pause" aria-hidden="true">
    <Icon name="pause" />
  </span>
  <span class="carousel-toggle__icon carousel-toggle__icon--play" aria-hidden="true">
    <Icon name="play" />
  </span>
  <span class="carousel-toggle__label">Pausar</span>
  <span class="sr-only">{target}</span>
</button>
