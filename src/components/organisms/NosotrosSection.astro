---
import { siteData } from "../../data/DataSite";
import PartnerCard from "../molecules/PartnerCard.astro";
---

<section class="about" id="nosotros">
  <div class="container">
    <div class="about__text">
      <h2>{siteData.about.title}</h2>
      <p>{siteData.about.description}</p>
    </div>

    <div class="about__partners">
      {siteData.about.partners.map((partner) => <PartnerCard partner={partner} />)}
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".partner-card");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (cards.length && !prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );

    cards.forEach((card) => observer.observe(card));
  } else {
    cards.forEach((card) => card.classList.add("is-visible"));
  }
</script>
