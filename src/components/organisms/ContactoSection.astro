---
import { siteData } from "../../data/DataSite";
import { buildWhatsAppLink } from "../../utils/whatsapp";

const whatsappHref = buildWhatsAppLink(
  siteData.contact.whatsappNumber,
  siteData.contact.defaultWhatsappMessage,
);
const mailHref = `mailto:${siteData.contact.email}`;
const telHref = `tel:+${siteData.contact.whatsappNumber}`;
---

<section class="contact" id="contacto">
  <div class="container contact__inner">
    <h2>{siteData.contactSection.title}</h2>
    <p class="contact__subtitle">{siteData.contactSection.subtitle}</p>

    <a
      class="btn btn-primary contact__cta"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteData.contactSection.ctaLabel}
    </a>

    <div class="contact__details">
      <a href={mailHref}>{siteData.contact.email}</a>
      <span class="contact__separator" aria-hidden="true">·</span>
      <a href={telHref}>{siteData.contact.phone}</a>
    </div>
  </div>
</section>
