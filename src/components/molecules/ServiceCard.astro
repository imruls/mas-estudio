---
import Icon from "../atoms/Icon.astro";
import { whatsappLink } from "../../utils/contact";
import type { PracticeArea } from "../../data/DataSite";

interface Props {
  area: PracticeArea;
  /* Marca la última card del carrusel. El alineado de snap por el final
     depende de esto y no de :last-of-type: el último hijo del track es el
     div del set clonado, y un selector posicional ahí es frágil. */
  isLast?: boolean;
  /* "2 de 5": la anuncia el lector de pantalla al entrar a la card como
     diapositiva del carrusel. Las del set clonado no la llevan. */
  slideLabel?: string;
}

const { area, isLast = false, slideLabel } = Astro.props;
---

<article
  class:list={["service-card", { "is-last": isLast }]}
  role={slideLabel ? "group" : undefined}
  aria-roledescription={slideLabel ? "diapositiva" : undefined}
  aria-label={slideLabel}
>
  <div class="service-card__icon">
    <Icon name={area.icon} />
  </div>
  <h3 class="service-card__title">{area.title}</h3>
  <p class="service-card__description">{area.description}</p>
  <a
    class="service-card__cta"
    href={whatsappLink(area.whatsappMessage)}
    target="_blank"
    rel="noopener noreferrer"
  >
    Más info
  </a>
</article>
