---
import { siteData } from "../../data/DataSite";
import TestimonialCard from "../molecules/TestimonialCard.astro";
---

<section class="testimonials" id="resenas">
  <div class="container">
    <h2 class="testimonials__title">{siteData.testimonialsSection.title}</h2>

    <div class="testimonials__carousel">
      <div class="testimonials__row">
        <div class="testimonials__viewport" id="testimonials-viewport-1">
          <div class="testimonials__track" id="testimonials-track-1">
            {
              siteData.testimonials.map((testimonial) => (
                <TestimonialCard testimonial={testimonial} />
              ))
            }
            <div class="testimonials__clone" aria-hidden="true" inert>
              {
                siteData.testimonials.map((testimonial) => (
                  <TestimonialCard testimonial={testimonial} />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="testimonials__row testimonials__row--secondary">
        <div class="testimonials__viewport" id="testimonials-viewport-2">
          <div class="testimonials__track" id="testimonials-track-2">
            {
              siteData.testimonials.map((testimonial) => (
                <TestimonialCard testimonial={testimonial} />
              ))
            }
            <div class="testimonials__clone" aria-hidden="true" inert>
              {
                siteData.testimonials.map((testimonial) => (
                  <TestimonialCard testimonial={testimonial} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const SPEED = 40; // px por segundo

  const setupAutoScroll = (
    viewport: HTMLElement,
    track: HTMLElement,
    direction: 1 | -1,
  ) => {
    let lastTime: number | null = null;
    let offset = 0;

    const halfWidth = () => track.scrollWidth / 2;

    const tick = (time: number) => {
      if (lastTime === null) lastTime = time;
      const delta = (time - lastTime) / 1000;
      lastTime = time;

      if (!prefersReducedMotion) {
        offset += SPEED * direction * delta;
      }

      const half = halfWidth();
      if (half > 0) {
        // scrollLeft can't go negative (the browser clamps it), so track
        // position in a signed "offset" and wrap it into range ourselves.
        viewport.scrollLeft = ((offset % half) + half) % half;
      }

      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  // Al arrastrar más allá del principio o el final del carrusel, iOS
  // Safari dispara su rebote elástico nativo (rubber-band), y eso
  // corrompe el repintado de las cards (confirmado con una grabación
  // real: el contenido desaparece y no vuelve). CSS
  // overscroll-behavior-x:none no alcanza a suprimirlo de forma
  // confiable en todas las versiones de iOS, así que se corta el
  // gesto táctil a mano antes de que el navegador llegue a iniciar
  // el rebote.
  const preventEdgeOverscroll = (viewport: HTMLElement) => {
    let touchStartX = 0;
    viewport.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    viewport.addEventListener(
      "touchmove",
      (e) => {
        const deltaX = touchStartX - e.touches[0].clientX;
        const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth;
        const atStart = viewport.scrollLeft <= 0;
        const atEnd = viewport.scrollLeft >= maxScrollLeft - 1;
        if ((atStart && deltaX < 0) || (atEnd && deltaX > 0)) {
          e.preventDefault();
        }
      },
      { passive: false },
    );
  };

  const viewport1 = document.getElementById("testimonials-viewport-1");
  const track1 = document.getElementById("testimonials-track-1");
  const viewport2 = document.getElementById("testimonials-viewport-2");
  const track2 = document.getElementById("testimonials-track-2");
  const isMobile = window.matchMedia("(max-width: 767px)").matches;

  // En mobile no hay auto-scroll: el usuario decide si desliza las
  // reseñas con el dedo (evita pisar scrollLeft mientras el navegador
  // maneja el scroll táctil nativo).
  if (viewport1 && track1 && !isMobile) setupAutoScroll(viewport1, track1, 1);
  if (viewport2 && track2 && !isMobile) setupAutoScroll(viewport2, track2, -1);
  if (viewport1 && isMobile) preventEdgeOverscroll(viewport1);
</script>
