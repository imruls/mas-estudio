---
import { Font } from "astro:assets";
import "../../styles/Style.css";
import { siteData } from "../../data/DataSite";
import Navbar from "../organisms/Navbar.astro";
import Footer from "../organisms/Footer.astro";
import WhatsAppFloatingButton from "../molecules/WhatsAppFloatingButton.astro";
import { buildStructuredData } from "../../utils/structuredData";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteData.seo.title, description = siteData.seo.description } =
  Astro.props;

// El dominio vive en astro.config.mjs (`site`), no duplicado en DataSite.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(siteData.seo.ogImage, Astro.site);
const structuredData = JSON.stringify(buildStructuredData(Astro.site!));
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteData.brand.fullName} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(siteData.seo.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteData.seo.ogImageHeight)} />
    <meta property="og:image:alt" content={siteData.seo.ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteData.seo.ogImageAlt} />

    <script type="application/ld+json" is:inline set:html={structuredData} />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-heading" preload />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Navbar />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloatingButton />
  </body>
</html>
