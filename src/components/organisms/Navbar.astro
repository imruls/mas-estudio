---
import { Image } from "astro:assets";
import navbarLogo from "../../assets/brand/logo-mas-navbar.png";
import { siteData } from "../../data/DataSite";
import NavLink from "../molecules/NavLink.astro";
---

<header class="navbar">
  <div class="container navbar__inner">
    <a href="#inicio" class="navbar__brand" aria-label={siteData.brand.shortName}>
      <Image
        src={navbarLogo}
        alt={siteData.brand.fullName}
        class="navbar__logo"
        width={137}
        height={50}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    {/* El toggle va antes del nav en el DOM: al abrir el menú, el siguiente
        Tab entra directo a los links. En desktop está oculto y en mobile el
        nav es fixed, así que el orden no cambia nada visualmente. */}
    <button
      class="navbar__toggle"
      id="navbar-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navbar-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="navbar__nav" id="navbar-nav">
      <ul class="navbar__links">
        {
          siteData.navbar.links.map((link) => (
            <li>
              <NavLink
                label={link.label}
                href={link.href}
                variant={link.href === "#contacto" ? "cta" : undefined}
              />
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".navbar");
  const toggle = document.getElementById("navbar-toggle");
  const nav = document.getElementById("navbar-nav");
  // Lo que queda tapado por el menú mobile abierto: mientras está abierto
  // se vuelve inert, así el foco no se pierde detrás del overlay.
  const covered = document.querySelectorAll<HTMLElement>(
    "main, .footer, .whatsapp-float",
  );
  const desktop = window.matchMedia("(min-width: 768px)");

  const isOpen = () => nav?.classList.contains("is-open") ?? false;

  const setOpen = (open: boolean) => {
    nav?.classList.toggle("is-open", open);
    toggle?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    covered.forEach((el) => (el.inert = open));
  };

  toggle?.addEventListener("click", () => setOpen(!isOpen()));

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  // Si se agranda la ventana con el menú abierto, el nav pasa a ser la
  // barra de desktop: hay que sacar el inert del resto de la página.
  desktop.addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });

  // El menú mobile se posiciona debajo del header con esta variable (ver
  // .navbar__nav en Style.css): con zoom o texto agrandado el header crece.
  if (header) {
    new ResizeObserver(() => {
      header.style.setProperty("--navbar-height", `${header.offsetHeight}px`);
    }).observe(header);
  }
</script>
