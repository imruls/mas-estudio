---
import { Image } from "astro:assets";
import type { Partner } from "../../data/DataSite";

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
---

{/* La foto mide 180px en mobile/tablet y 225px en desktop (ver Style.css).
    El original mide 450px (2x de 225), recortado a cabeza y hombros: Astro no
    reescala hacia arriba, así que no hay que pedir anchos mayores. */}
<article class="partner-card">
  <Image
    src={partner.photo}
    alt=""
    aria-hidden="true"
    class="partner-card__photo"
    width={225}
    height={225}
    widths={[180, 225, 360, 450]}
    sizes="(min-width: 1024px) 225px, 180px"
    loading="lazy"
  />
  <div class="partner-card__content">
    <h3 class="partner-card__name">{partner.name}</h3>
    <p class="partner-card__role">{partner.role}</p>
    <p class="partner-card__bio">{partner.bio}</p>
  </div>
</article>
