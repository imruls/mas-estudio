---
import Icon from "../atoms/Icon.astro";
import WhatsAppIcon from "../atoms/WhatsAppIcon.astro";
import NewTabNotice from "../atoms/NewTabNotice.astro";
import { siteData } from "../../data/DataSite";
import { mailtoLink, whatsappLink } from "../../utils/contact";
---

<section class="contact" id="contacto" aria-labelledby="contacto-titulo">
  <div class="container">
    <div class="contact__card">
      <h2 id="contacto-titulo">{siteData.contactSection.title}</h2>
      <p class="contact__subtitle">{siteData.contactSection.subtitle}</p>

      <div class="contact__ctas">
        <a
          class="btn contact__cta"
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon size={22} />
          {siteData.contactSection.ctaLabel}
          <NewTabNotice />
        </a>

        <a class="btn contact__cta" href={mailtoLink()}>
          <Icon name="mail" />
          {siteData.contactSection.ctaEmailLabel}
        </a>
      </div>
    </div>
  </div>
</section>
