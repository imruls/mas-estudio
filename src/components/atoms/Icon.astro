---
import car from "lucide-static/icons/car.svg?raw";
import scroll from "lucide-static/icons/scroll.svg?raw";
import building from "lucide-static/icons/building.svg?raw";
import home from "lucide-static/icons/home.svg?raw";
import users from "lucide-static/icons/users.svg?raw";

// nombres de PracticeArea.icon en DataSite.ts -> ícono de lucide-static
const icons: Record<string, string> = { car, scroll, building, home, family: users };

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={["icon", className]} set:html={icons[name]} />
