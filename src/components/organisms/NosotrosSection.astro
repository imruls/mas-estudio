---
import { siteData } from "../../data/DataSite";
import PartnerCard from "../molecules/PartnerCard.astro";
---

<section class="about" id="nosotros">
  <div class="container">
    <div class="about__text">
      <h2>{siteData.about.title}</h2>
      <p>{siteData.about.description}</p>
    </div>

    <div class="about__partners">
      {siteData.about.partners.map((partner) => <PartnerCard partner={partner} />)}
    </div>
  </div>
</section>

<script>
  /* Ver Hero: sin imports para que Astro lo deje inline. */
  const cards = document.querySelectorAll<HTMLElement>(".partner-card");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const reveal = (card: HTMLElement) => card.classList.add("is-visible");

  if (prefersReducedMotion) {
    cards.forEach(reveal);
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          reveal(entry.target as HTMLElement);
        }
      },
      { threshold: 0.3 },
    );

    cards.forEach((card) => observer.observe(card));
  }
</script>
