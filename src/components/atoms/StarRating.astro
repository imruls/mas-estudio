---
interface Props {
  rating: number; // 1-5
}

const { rating } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<div class="star-rating" aria-label={`Calificación: ${rating} de 5 estrellas`}>
  {
    stars.map((star) => (
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill={star <= rating ? "currentColor" : "none"}
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z" />
      </svg>
    ))
  }
</div>
