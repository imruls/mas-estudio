---
import { siteData } from "../../data/DataSite";
import TestimonialCard from "../molecules/TestimonialCard.astro";
import CarouselToggle from "../molecules/CarouselToggle.astro";

const total = siteData.testimonials.length;
---

<section class="testimonials" id="resenas" aria-labelledby="resenas-titulo">
  <div class="container">
    <h2 class="testimonials__title" id="resenas-titulo">{siteData.testimonialsSection.title}</h2>

    <div class="testimonials__carousel" id="testimonials-carousel">
      <div class="testimonials__row">
        {/* Sin links adentro, el viewport necesita su propio tabindex para
            que se pueda desplazar con las flechas del teclado. */}
        <div
          class="testimonials__viewport"
          id="testimonials-viewport-1"
          tabindex="0"
          role="region"
          aria-roledescription="carrusel"
          aria-label="Reseñas de clientes"
        >
          <div class="testimonials__track" id="testimonials-track-1">
            {
              siteData.testimonials.map((testimonial, index) => (
                <TestimonialCard
                  testimonial={testimonial}
                  isLast={index === total - 1}
                  slideLabel={`${index + 1} de ${total}`}
                />
              ))
            }
            <div class="testimonials__clone" aria-hidden="true" inert>
              {
                siteData.testimonials.map((testimonial) => (
                  <TestimonialCard testimonial={testimonial} />
                ))
              }
            </div>
          </div>
        </div>
      </div>

      {/* La segunda fila repite las mismas reseñas: es decorativa, así que
          se oculta entera a lectores de pantalla (si no, las leían dos
          veces). No lleva inert para que se pueda seguir desplazando con el
          mouse. */}
      <div class="testimonials__row testimonials__row--secondary" aria-hidden="true">
        {/* tabindex="-1": Chrome vuelve enfocable con Tab un contenedor con
            scroll que no tiene nada enfocable adentro, y esta fila está
            oculta para lectores de pantalla. */}
        <div class="testimonials__viewport" id="testimonials-viewport-2" tabindex="-1">
          <div class="testimonials__track" id="testimonials-track-2">
            {
              siteData.testimonials.map((testimonial) => (
                <TestimonialCard testimonial={testimonial} />
              ))
            }
            <div class="testimonials__clone" inert>
              {
                siteData.testimonials.map((testimonial) => (
                  <TestimonialCard testimonial={testimonial} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="testimonials__controls">
      <CarouselToggle id="testimonials-toggle" target="el carrusel de reseñas" />
    </div>
  </div>
</section>

<script>
  /* Ver Hero: sin imports para que Astro lo deje inline. */
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const SPEED = 40; // px por segundo

  // Igual que en el carrusel de servicios: isPaused lo manejan el foco y
  // el toque, y se reanuda solo (el hover no pausa: para eso está el
  // botón). userPaused es el botón de pausa (WCAG 2.2.2) y queda hasta que
  // lo vuelvan a tocar.
  let isPaused = false;
  let userPaused = false;
  let resumeTimer: number | undefined;

  const setupAutoScroll = (
    viewport: HTMLElement,
    track: HTMLElement,
    direction: 1 | -1,
  ) => {
    let lastTime: number | null = null;
    let offset = 0;
    // Último scrollLeft que escribió la animación. Si en el frame siguiente
    // no coincide, lo movió el usuario (rueda, trackpad) y se sigue desde ahí
    // en vez de pisarle el scroll.
    let lastScroll = 0;

    // Período del loop: lo que mide un set de cards más el gap que lo separa
    // de la copia. Con scrollWidth / 2 a secas faltaba medio gap y cada
    // vuelta daba un salto de 20px en desktop.
    const halfWidth = () =>
      (track.scrollWidth + parseFloat(getComputedStyle(track).columnGap || "0")) /
      2;

    const tick = (time: number) => {
      if (lastTime === null) lastTime = time;
      const delta = (time - lastTime) / 1000;
      lastTime = time;

      if (isPaused || userPaused) {
        // En pausa no se toca scrollLeft, así el usuario puede desplazar
        // a mano (rueda, trackpad, flechas). Al reanudar se sigue desde
        // donde lo dejó.
        offset = viewport.scrollLeft;
      } else {
        if (Math.abs(viewport.scrollLeft - lastScroll) > 1) {
          offset = viewport.scrollLeft;
        }
        offset += SPEED * direction * delta;

        const half = halfWidth();
        if (half > 0) {
          // scrollLeft can't go negative (the browser clamps it), so track
          // position in a signed "offset" and wrap it into range ourselves.
          viewport.scrollLeft = ((offset % half) + half) % half;
        }
        lastScroll = viewport.scrollLeft;
      }

      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const carousel = document.getElementById("testimonials-carousel");
  const toggle = document.getElementById("testimonials-toggle");
  const viewport1 = document.getElementById("testimonials-viewport-1");
  const track1 = document.getElementById("testimonials-track-1");
  const viewport2 = document.getElementById("testimonials-viewport-2");
  const track2 = document.getElementById("testimonials-track-2");
  const isMobile = window.matchMedia("(max-width: 767px)").matches;

  // En mobile no hay auto-scroll: el usuario decide si desliza las
  // reseñas con el dedo (evita pisar scrollLeft mientras el navegador
  // maneja el scroll táctil nativo). Con prefers-reduced-motion tampoco
  // arranca el loop: dejarlo corriendo sin avanzar el offset reescribía
  // scrollLeft en cada frame y bloqueaba el scroll manual del usuario.
  const autoScroll = !isMobile && !reducedMotion;

  if (autoScroll && carousel) {
    const pause = () => {
      isPaused = true;
      window.clearTimeout(resumeTimer);
    };
    const resume = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        isPaused = false;
      }, 300);
    };

    carousel.addEventListener("focusin", pause);
    carousel.addEventListener("focusout", resume);
    carousel.addEventListener("pointerdown", pause);
    carousel.addEventListener("pointerup", resume);
    carousel.addEventListener("pointercancel", resume);
    carousel.addEventListener("touchstart", pause, { passive: true });
    carousel.addEventListener("touchend", resume, { passive: true });
    carousel.addEventListener("touchcancel", resume, { passive: true });

    if (toggle) {
      toggle.hidden = false;
      const label = toggle.querySelector(".carousel-toggle__label");

      toggle.addEventListener("click", () => {
        userPaused = !userPaused;
        toggle.dataset.paused = String(userPaused);
        if (label) label.textContent = userPaused ? "Reanudar" : "Pausar";
      });
    }

    if (viewport1 && track1) setupAutoScroll(viewport1, track1, 1);
    if (viewport2 && track2) setupAutoScroll(viewport2, track2, -1);
  }
</script>
