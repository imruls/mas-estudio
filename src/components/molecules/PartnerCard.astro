---
import { Image } from "astro:assets";
import type { Partner } from "../../data/DataSite";

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
---

{/* TODO: reemplazar por foto real del socio.
    densities va hasta 1.5x y no 2x: el original mide 320px y Astro no reescala
    hacia arriba, así que un 2x (360px) no daría más detalle. */}
<article class="partner-card">
  <Image
    src={partner.photo}
    alt=""
    aria-hidden="true"
    class="partner-card__photo"
    width={180}
    height={180}
    densities={[1, 1.5]}
    loading="lazy"
  />
  <div class="partner-card__content">
    <h3 class="partner-card__name">{partner.name}</h3>
    <p class="partner-card__role">{partner.role}</p>
    <p class="partner-card__bio">{partner.bio}</p>
  </div>
</article>
